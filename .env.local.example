# === 서버 전용 키 (브라우저에 절대 내려가지 않음) ===
# api/*.js 서버리스 함수 안에서만 process.env로 읽습니다. 클라이언트 코드(config.js 등)는
# 이 값들을 import하지 않습니다.
#
# 로컬에서 테스트하려면:
#   cp .env.local.example .env.local   (Windows: copy .env.local.example .env.local)
# 그 후 아래 값을 채우고 `vercel dev`로 실행하세요 (일반 정적 서버는 /api를 실행하지 못합니다).
#
# 배포 환경(Vercel)에는 이 파일이 아니라 Vercel 프로젝트 설정 → Environment Variables에
# 아래 키들을 똑같은 이름으로 등록해야 합니다.

# 구글 리뷰 조회(api/reviews.js)용. 발급: Google Cloud Console → API 및 서비스 → 사용자 인증 정보에서
# API 키 생성 후 "Places API (New)"를 사용 설정하고 결제(billing)가 켜진 프로젝트여야 합니다.
GOOGLE_PLACES_API_KEY=

# AI 리뷰 분석(api/analyze-reviews.js)용 제미나이 키. 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 문화공공데이터광장(KCISA) 오픈API 서비스키(api/kcisa.js). 비워두면 mockData.js 목업 데이터로
# 자동 대체됩니다.
KCISA_SERVICE_KEY=

# === 클라이언트 키 (빌드 시 브라우저 번들로 구워짐) ===
# 아래 2개는 원래 브라우저 SDK가 직접 쓰는 값이라 배포되면 어차피 공개됩니다(비밀 아님).
# 관리를 한곳으로 모으기 위해 같은 .env.local에 둘 뿐입니다. `npm run build`
# (scripts/generate-secrets.js)가 이 값들로 secrets.generated.js를 생성하고, config.js가 그 파일을
# import해서 씁니다. 값을 바꿨다면 `npm run build`를 다시 실행해야 반영됩니다.

# 카카오 개발자센터(https://developers.kakao.com/) 앱 키 화면의 "JavaScript 키".
# 플랫폼 설정에 로컬 서버 주소(예: http://localhost:5501)를 Web 플랫폼으로 등록해야 동작합니다.
# "내 주변" 위치 기반 검색(nearbyApi.js)에 사용됩니다.
KAKAO_JS_KEY=

# 같은 화면의 "REST API 키" — 지금 코드에서는 사용하지 않지만 보관용으로 넣어둡니다.
KAKAO_REST_API_KEY=
